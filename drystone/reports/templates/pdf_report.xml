<?xml version="1.0" encoding="UTF-8"?>
<reportTemplate>
  <html><![CDATA[
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Drystone - AWS Security Findings Report</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 8mm 0 12mm 0;
      background: #f3f4f6;
      @bottom-left {
        content: "Drystone Security Report";
        font-family: 'Segoe UI', sans-serif;
        font-size: 8px;
        color: #6b7280;
        margin-left: 15mm;
      }
      @bottom-right {
        content: "Confidential Information";
        font-family: 'Segoe UI', sans-serif;
        font-size: 8px;
        color: #6b7280;
        margin-right: 15mm;
      }
    }

    @page :first {
      margin: 0;
      @bottom-left { content: ""; }
      @bottom-right { content: ""; }
    }

    * { box-sizing: border-box; }

    :root {
      --bg-top: #17143d;
      --bg-bottom: #0d0f30;
      --surface: #ffffff;
      --surface-soft: #f8fafc;
      --surface-border: #d8dee9;
      --text-primary: #111827;
      --text-muted: #6b7280;
      --accent-coral: #b8c6ff;
      --accent-purple: #8189b3;
      --accent-amber: #f59e0b;
      --accent-teal: #0891b2;
    }

    html { background: #f3f4f6; }

    body {
      font-family: 'Segoe UI', Tahoma, sans-serif;
      line-height: 1.45;
      margin: 0;
      padding: 0;
      background: transparent;
      color: var(--text-primary);
      font-size: 11px;
      position: relative;
      z-index: 1;
    }

    .cover {
      min-height: 297mm;
      padding: 0 18mm;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 100%);
      page-break-after: always;
    }

    .report-content {
      padding: 7mm 15mm 8mm 15mm;
      background: #f3f4f6;
    }

    body > * {
      position: relative;
      z-index: 1;
    }

    .ascii-header {
      margin: 0;
      padding: 0;
      background: transparent;
      border: none;
      border-radius: 7px;
      text-align: center;
    }

    .drystone-logo {
      margin: 0;
      padding: 0;
      border: none;
      background: transparent;
      box-shadow: none;
      font-family: 'Courier New', monospace;
      font-size: 11px;
      line-height: 1.05;
      white-space: pre;
      display: inline-block;
      text-align: left;
    }

    .drystone-logo-line {
      white-space: pre;
    }

    .header-tagline,
    .header-version,
    .header-motto,
    .header-analysis-title {
      margin: 0;
      color: #ffffff;
      text-align: center;
      font-family: 'Courier New', monospace;
      letter-spacing: 0.2px;
    }

    .header-tagline {
      margin-top: 20px;
      font-size: 14px;
      font-weight: 700;
    }

    .header-version {
      margin-top: 4px;
      font-size: 10px;
      font-weight: 700;
    }

    .header-motto {
      margin-top: 10px;
      font-size: 13px;
      font-weight: 700;
    }

    .header-analysis-title {
      margin: 24px 0 0 0;
      color: #ffffff;
      font-size: 34px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      text-align: center;
      font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .company-name {
      font-size: 24px;
      font-weight: 700;
      margin: 10px 0 6px 0;
      letter-spacing: 1px;
    }

    .subtitle { font-size: 14px; margin: 0; }

    h2 {
      color: #111827;
      font-size: 1.45em;
      margin: 24px 0 14px 0;
      font-weight: 700;
      border-bottom: 2px solid #d1d5db;
      padding-bottom: 7px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      page-break-after: avoid;
    }

    h3 {
      color: #111827;
      font-size: 1.1em;
      margin: 16px 0 10px 0;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 10px;
      padding: 14px;
      margin: 12px 0;
      page-break-inside: avoid;
    }

    .risk-widget {
      margin-bottom: 1.5rem;
    }

    .scope-definition {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 12px;
      margin: 10px 0 14px 0;
      page-break-inside: avoid;
    }

    .scope-row {
      display: flex;
      gap: 10px;
      align-items: baseline;
      padding: 7px 2px;
      border-bottom: 1px dashed #cbd5e1;
    }

    .scope-row:last-child {
      border-bottom: none;
    }

    .scope-label {
      display: inline-block;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
      font-size: 9px;
      min-width: 140px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .scope-value {
      display: inline-block;
      color: #111827;
      font-size: 11px;
      font-weight: 600;
      word-break: break-word;
    }

    .findings-summary-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 14px 0;
      background: var(--surface);
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--surface-border);
      font-size: 10px;
    }

    .findings-summary-table th {
      background: #eef2f7;
      color: #111827;
      padding: 11px 8px;
      text-align: left;
      font-weight: 700;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .findings-summary-table td {
      padding: 10px 8px;
      border-bottom: 1px solid var(--surface-border);
      vertical-align: top;
      background: var(--surface);
      color: #111827;
    }

    .findings-summary-table th:nth-child(1),
    .findings-summary-table th:nth-child(3),
    .findings-summary-table th:nth-child(4),
    .findings-summary-table th:nth-child(5),
    .findings-summary-table td:nth-child(1),
    .findings-summary-table td:nth-child(3),
    .findings-summary-table td:nth-child(4),
    .findings-summary-table td:nth-child(5) {
      text-align: center;
    }

    .severity-pill {
      display: inline-block;
      padding: 2px 9px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 700;
      border: 1px solid transparent;
      line-height: 1.2;
      white-space: nowrap;
    }

    .severity-critical { color: #b91c1c; font-weight: 700; }
    .severity-high { color: #b45309; font-weight: 700; }
    .severity-medium { color: #0369a1; font-weight: 700; }
    .severity-low { color: #047857; font-weight: 700; }

    .severity-pill.severity-critical { background: #fee2e2; border-color: #fecaca; }
    .severity-pill.severity-high { background: #ffedd5; border-color: #fed7aa; }
    .severity-pill.severity-medium { background: #e0f2fe; border-color: #bae6fd; }
    .severity-pill.severity-low { background: #dcfce7; border-color: #bbf7d0; }

    .phase-description {
      color: var(--text-muted, #6b7280);
      font-style: italic;
      margin-bottom: 12px;
      font-size: 0.92em;
    }

    .findings-summary-table .totals-row td {
      background: #f0f4ff;
      border-top: 2px solid #6366f1;
    }

    .phase-summary-table th:nth-child(1),
    .phase-summary-table td:nth-child(1) {
      text-align: left;
    }

    .severity-summary-table th:nth-child(1),
    .severity-summary-table td:nth-child(1) {
      text-align: left;
    }

    .phase-pill {
      display: inline-block;
      padding: 2px 9px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 700;
      border: 1px solid transparent;
      line-height: 1.2;
      white-space: nowrap;
    }

    .phase-pill-1 {
      color: #374151;
      background: transparent;
      border-color: #d1d5db;
    }

    .phase-pill-2 {
      color: #374151;
      background: transparent;
      border-color: #d1d5db;
    }

    .individual-finding {
      background: var(--surface);
      margin: 12px 0;
      border-radius: 10px;
      border: 1px solid var(--surface-border);
      padding: 14px;
      page-break-inside: auto;
      page-break-after: avoid;
    }

    .individual-finding + .individual-finding {
      page-break-before: always;
    }

    .individual-finding h3 {
      margin-top: 0;
      border-bottom: 2px solid var(--accent-coral);
      padding-bottom: 5px;
    }

    .finding-description {
      background: var(--surface-soft);
      padding: 12px;
      border-radius: 8px;
      border-left: 4px solid #a0a8cc;
      page-break-inside: avoid;
    }

    .finding-resources {
      background: var(--surface-soft);
      border: 1px solid var(--surface-border);
      border-radius: 8px;
      padding: 10px;
      margin-top: 10px;
      page-break-inside: avoid;
    }

    .finding-resources.finding-evidence {
      page-break-inside: auto;
    }

    .finding-remediation {
      background: #f0fdfa;
      border-left: 4px solid var(--accent-teal);
      border-radius: 8px;
      padding: 10px;
      margin-top: 10px;
      page-break-inside: avoid;
    }

    .finding-impact {
      background: #fff7ed;
      border-left: 3px solid #f97316;
      border-radius: 6px;
      padding: 12px 16px;
      margin: 12px 0;
      page-break-inside: avoid;
    }

    .finding-impact h4 {
      color: #c2410c;
      margin: 0 0 8px 0;
      font-size: 0.9em;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .finding-exploitation {
      background: #fff7ed;
      border-left: 4px solid var(--accent-amber);
      border-radius: 8px;
      padding: 10px;
      margin-top: 10px;
      page-break-inside: avoid;
    }

    .finding-analogy {
      margin: 0.75rem 0 0 0;
      padding: 0.5rem 0.75rem;
      border-left: 3px solid #6c757d;
      background: #f8f9fa;
      color: #555;
      font-style: italic;
      font-size: 0.9em;
    }

    .resource-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .resource-list li {
      background: #f8fafc;
      border-left: 3px solid #cbd5e1;
      border-radius: 5px;
      padding: 6px 8px;
      margin-bottom: 5px;
      font-size: 9px;
      font-family: 'Courier New', monospace;
      word-break: break-all;
      color: #334155;
    }

    .bar {
      width: 100%;
      height: 10px;
      background: #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
    }

    .bar-fill { display: block; height: 100%; }
    .bar-fill.severity-critical { background: #dc2626; }
    .bar-fill.severity-high { background: #f59e0b; }
    .bar-fill.severity-medium { background: #0ea5e9; }
    .bar-fill.severity-low { background: #10b981; }

    .code-block {
      background: #f3f4f6;
      color: #111827;
      border-radius: 8px;
      padding: 12px;
      font-size: 9px;
      line-height: 1.3;
      white-space: pre-wrap;
      page-break-inside: auto;
    }

    .finding-evidence .code-block {
      background: #303030;
      color: #ffffff;
    }

    .finding-affected .resource-list li {
      background: #303030;
      color: #ffffff;
      border-left-color: #555555;
    }

    .finding-validation .resource-list li {
      background: #303030;
      color: #ffffff;
      border-left-color: #555555;
    }

    .page-break { page-break-before: always; }

    /* Prevent orphaned section headers — keep h2 with following content */
    .section-group {
      page-break-inside: avoid;
    }
    h2 + .card {
      page-break-before: avoid;
    }

    .index-list {
      margin: 0;
      padding-left: 18px;
    }

    .index-list > li {
      margin-bottom: 6px;
    }

    .index-sublist {
      margin-top: 6px;
      margin-bottom: 4px;
      padding-left: 18px;
    }

    .index-sublist li {
      margin-bottom: 4px;
      font-size: 10px;
      color: #374151;
    }

    .index-code {
      font-family: 'Courier New', monospace;
      font-weight: 700;
    }

    /* Executive Narrative */
    .executive-narrative p {
      font-size: 11px;
      line-height: 1.6;
      color: #374151;
      margin-bottom: 14px;
    }

    .assessment-rating {
      border-left: 4px solid #6b7280;
      background: #f9fafb;
      border-radius: 6px;
      padding: 12px 16px;
      margin-top: 10px;
    }

    .rating-label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      color: #6b7280;
      letter-spacing: 0.05em;
      display: block;
      margin-bottom: 4px;
    }

    .rating-value {
      font-size: 16px;
      font-weight: 700;
      display: block;
      margin-bottom: 8px;
    }

    .rating-desc {
      font-size: 10px;
      color: #4b5563;
      margin: 0;
      line-height: 1.5;
    }

    .rating-excellent  { border-left-color: #16a34a; background: #f0fdf4; }
    .rating-excellent  .rating-value { color: #15803d; }
    .rating-very-good  { border-left-color: #22c55e; background: #f0fdf4; }
    .rating-very-good  .rating-value { color: #16a34a; }
    .rating-good       { border-left-color: #eab308; background: #fefce8; }
    .rating-good       .rating-value { color: #ca8a04; }
    .rating-improvable { border-left-color: #f97316; background: #fff7ed; }
    .rating-improvable .rating-value { color: #ea580c; }
    .rating-critical   { border-left-color: #dc2626; background: #fef2f2; }
    .rating-critical   .rating-value { color: #dc2626; }

    /* Risk Scale */
    .risk-scale-bar {
      display: flex;
      height: 18px;
      border-radius: 10px;
      overflow: hidden;
      margin: 10px 0 6px 0;
    }
    .risk-scale-bar .rs-segment {
      flex: 1;
      position: relative;
    }
    .risk-scale-bar .rs-appropriate { background: #16a34a; }
    .risk-scale-bar .rs-low { background: #22c55e; }
    .risk-scale-bar .rs-medium { background: #eab308; }
    .risk-scale-bar .rs-high { background: #f97316; }
    .risk-scale-bar .rs-critical { background: #dc2626; }
    .risk-scale-indicator {
      position: absolute;
      top: -4px;
      width: 4px;
      height: 26px;
      background: #111827;
      border-radius: 2px;
      z-index: 2;
    }
    .risk-scale-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      font-size: 9.5px;
    }
    .risk-scale-table th {
      text-align: left;
      padding: 6px 8px;
      background: #f3f4f6;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      border-bottom: 1px solid #d1d5db;
    }
    .risk-scale-table td {
      padding: 6px 8px;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }
    .risk-scale-table .rs-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      margin-right: 6px;
      vertical-align: middle;
    }

    /* Document Control */
    .document-control {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 12px;
      margin: 10px 0 14px 0;
      page-break-inside: avoid;
    }

    /* Conditions Section */
    .conditions-list {
      list-style: disc;
      padding-left: 20px;
      margin: 6px 0;
    }
    .conditions-list li {
      margin-bottom: 4px;
      font-size: 10.5px;
      color: #374151;
    }

  </style>
</head>
<body>
  <div class="cover">
    <div class="ascii-header">
      <div class="drystone-logo">{{DRYSTONE_BANNER_HTML}}</div>
      <p class="header-tagline">AWS Security Audit powered by AI</p>
      <p class="header-version">v1.0.0</p>
    </div>

    <p class="header-analysis-title">{{ANALYSIS_TITLE}}</p>
  </div>

  <div class="report-content">

  {{DOCUMENT_CONTROL}}

  <h2>Scope Definition</h2>
  <div class="scope-definition">
    {{SCOPE_DEFINITION}}
  </div>

  {{CONDITIONS_SECTION}}

  <h2>Inventory</h2>
  <div class="card">
    {{INVENTORY_SECTION}}
  </div>
  {{INVENTORY_ENV_SECTION}}

  <h2>Executive Summary</h2>
  <div class="card executive-narrative">
    {{EXECUTIVE_NARRATIVE}}
  </div>

  {{METHODOLOGY_SECTION}}

  <div class="section-group">
  <h2>Risk Analysis</h2>
  <div class="card risk-widget">
    <h3>Severity Distribution</h3>
    <table class="findings-summary-table severity-summary-table">
      <thead><tr><th>Severity</th><th>Distribution</th><th>Count</th></tr></thead>
      <tbody>{{SEVERITY_CHART}}</tbody>
    </table>
  </div>
  <div class="card risk-widget">
    {{PHASE_FINDINGS_TABLE}}
  </div>
  <div class="card risk-widget">
    <h3>Top 5 Affected Resources</h3>
    <ul>{{TOP_RESOURCES}}</ul>
  </div>
  <div class="card risk-widget">
    <h3>Findings Summary</h3>
    <table class="findings-summary-table">
      <thead>
        <tr><th>ID</th><th>Title</th><th>Severity</th><th>Risk</th><th>Resources</th></tr>
      </thead>
      <tbody>{{TOP_FINDINGS_ROWS}}</tbody>
    </table>
  </div>
  </div>

  {{PAGEBREAK_ARCH_CORR}}
  {{ARCHITECTURE_SECTION}}

  {{PAGEBREAK_FINDINGS}}
  {{FINDINGS_BY_SEVERITY}}

  <div class="page-break"></div>

  <h2>Observations</h2>
  <div class="card">{{OBSERVATIONS}}</div>

  <h2>Remediation Timeline (Recommended)</h2>
  <div class="card">{{REMEDIATION_TIMELINE}}</div>

  {{CORRELATION_SECTION}}

  <h2>References</h2>
  <div class="card"><ul>{{REFERENCES}}</ul></div>

  <h2>Notes</h2>
  <div class="card">{{FOOTER_NOTES}}</div>
  </div>
</body>
</html>
]]></html>
</reportTemplate>
