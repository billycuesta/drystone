{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drystone Agent Response Schema",
  "description": "Expected structure of responses from LLM agents for analysis",
  "type": "object",
  "required": ["findings", "risk_score"],
  "properties": {
    "findings": {
      "type": "array",
      "description": "Array of security findings",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "risk_score"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding identifier (e.g., IAM-001)",
            "pattern": "^[A-Z]+-[0-9]+$"
          },
          "title": {
            "type": "string",
            "description": "Finding title",
            "minLength": 5,
            "maxLength": 200
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Info"],
            "description": "Finding severity level"
          },
          "risk_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "Risk score from 0 to 10"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the finding"
          },
          "evidence": {
            "type": "string",
            "description": "Evidence supporting this finding"
          },
          "remediation": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Remediation steps"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "References (CIS, NIST, URLs)"
          },
          "affected_resources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ARNs or IDs of affected resources"
          }
        }
      }
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Overall risk score (aggregate of findings)"
    },
    "summary": {
      "type": "string",
      "description": "Summary of analysis results"
    }
  },
  "additionalProperties": false
}
